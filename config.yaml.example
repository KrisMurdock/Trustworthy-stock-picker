schema_version: 1
# data is a symlink to /mnt/windows_database on the host. Do not create a local directory.
data_dir: data
require_cifs: true
pool_file: leaders.yaml
poll_interval: 5m
request_timeout: 10s

# Independent minute loop in run; native Tencent 5m, aggregated into 15/30/60m.
intraday:
  enabled: true
  poll_interval: 1m # Per-stock minimum; bounded concurrency and provider latency affect actual cadence.
  request_interval: 350ms # Global spacing between minute requests; minimum 350ms.
  workers: 3
  calibration_at: '15:10' # Asia/Shanghai; one successful full-session reconciliation per stock/day.
  # tencent_endpoint: https://proxy.finance.qq.com/ifzqgtimg/appstock/app/kline/mkline

# Go-native clients, tried in this order; no Python SDK or AKTools service.
market:
  providers: [tencent, sina, baostock, tushare, eastmoney]
  request_interval: 1s # Per provider; minimum 350ms. Raise for a lower Tushare quota.
  attempt_timeout: 60s # Whole window including pagination; parent cancellation still aborts.
  failure_threshold: 3 # Consecutive transient failures across stocks.
  failure_cooldown: 5m # Skip an unavailable source, then allow one recovery probe.
  tushare_token_env: TUSHARE_TOKEN # Missing token skips Tushare; a Tushare-only config fails.
  # eastmoney is the upstream used by AKShare stock_zh_a_hist, not the AKShare library.
  # Defaults below can be overridden for a controlled proxy or local integration tests.
  # tencent_endpoint: https://proxy.finance.qq.com/ifzqgtimg/appstock/app/newfqkline/get
  # sina_endpoint: https://finance.sina.com.cn/realstock/company
  # Listing metadata is independent of price provider ordering; confirmed dates are cached in data_dir.
  # listing_endpoint: https://vip.stock.finance.sina.com.cn/corp/go.php/vISSUE_NewStock/stockid
  # baostock_address: public-api.baostock.com:10030
  # tushare_endpoint: https://api.tushare.pro
  # eastmoney_endpoint: https://push2his.eastmoney.com/api/qt/stock/kline/get

# Read-only dashboard starts with run / make run. No separate frontend process.
web:
  enabled: true
  listen: '127.0.0.1:8080' # STOCK_WATCHER_WEB_ADDR overrides this address.

daily:
  run_at: '18:05'  # Asia/Shanghai, completed sessions only
  history_days: 365 # Analysis window, capped at ten years / listing date; raw history covers that full span.
  adjust: qfq

selection:
  enabled: true
  min_score: 70
  top_n: 5
  min_volume_ratio: 1.2
  rsi_min: 50
  rsi_max: 80
  min_day_change_pct: -3
  max_day_change_pct: 7

sync:
  min_coverage_pct: 95 # Ten-year completeness gate; validated histories are saved below this threshold.
  min_analyzable_pct: 90 # Current-session analyzability gate; suspended stocks do not enter reports.
  status_refresh_days: 30 # Re-check recent suspension/calendar facts on every sync (5-250 days).
  incremental_bars: 5

# Set enabled=true to replace legacy filtering with full-pool short-horizon ranking.
# Old configurations keep legacy behavior. Costs other than commission are assumptions.
strategy:
  schema_version: 1
  enabled: false
  target_net_pct: 3       # also measures 2.5%; allowed targets: 2.5 or 3
  stop_net_pct: -3        # strict net-loss cap <3%; trigger reserves fees/slippage/ticks, gaps can exceed
  max_holding_days: 5     # trading days AFTER buying, earliest sale on day 1
  trade_cash: 20000       # inclusive of buy fees; replace with actual per-stock budget
  commission_rate: 0.0001 # user: 万一, charged on both sides
  min_commission: 5       # assumption; set 0 if the broker waives the minimum
  transfer_rate: 0.00001
  sell_stamp_rate: 0.0005
  slippage_rate: 0.0005
  max_entry_gap_pct: 3
  min_evidence: 60
  min_training_days: 40
  holdout_days: 40
  min_rank_score: 60

# Structure gate over qfq daily bars plus same-snapshot 30m/5m bars.
# shadow records evidence and eligible ranks without changing formal picks;
# switch to enforce only after the shadow review period.
structure_guard:
  mode: shadow

notify:
  channels:
    - name: feishu-main
      type: feishu
      enabled: false
      # Optional private YAML containing webhook and optional secret; relative to this config.
      # credentials_file: feishu.config
      webhook_env: FEISHU_WEBHOOK
      secret_env: FEISHU_SECRET

# Legacy compatibility. Use notify.channels for new deployments.
# feishu:
#   enabled: false
#   # credentials_file: feishu.config
#   # Set FEISHU_WEBHOOK and optionally FEISHU_SECRET in a private environment file.

# Official SZSE/SSE 2026 holiday schedule. Calendar must be updated before 2027.
calendar:
  valid_from: '2026-01-01'
  valid_through: '2026-12-31'
  holidays:
    - '2026-01-01'
    - '2026-01-02'
    - '2026-02-16'
    - '2026-02-17'
    - '2026-02-18'
    - '2026-02-19'
    - '2026-02-20'
    - '2026-02-23'
    - '2026-04-06'
    - '2026-05-01'
    - '2026-05-04'
    - '2026-05-05'
    - '2026-06-19'
    - '2026-09-25'
    - '2026-10-01'
    - '2026-10-02'
    - '2026-10-05'
    - '2026-10-06'
    - '2026-10-07'

# 生产算法版本与执行期限；auto 保留 strategy.enabled 的兼容选择。
# 显式版本须与 strategy.enabled 匹配，不会自动启用实验算法。
analysis:
  engine: auto
  timeout: 10m
  sync_timeout: 90m
