schema_version: 1
# data is a symlink to /mnt/windows_database on the host. Do not create a local directory.
data_dir: data
require_cifs: true
pool_file: leaders.yaml
poll_interval: 5m
request_timeout: 10s

daily:
  run_at: '18:05'  # Asia/Shanghai, completed sessions only
  history_days: 365
  adjust: qfq

selection:
  enabled: true
  min_score: 70
  top_n: 5
  min_volume_ratio: 1.2
  rsi_min: 50
  rsi_max: 80
  min_day_change_pct: -3
  max_day_change_pct: 7

feishu:
  enabled: false
  # Set FEISHU_WEBHOOK and optionally FEISHU_SECRET in a private environment file.

# Official SZSE/SSE 2026 holiday schedule. Calendar must be updated before 2027.
calendar:
  valid_from: '2026-01-01'
  valid_through: '2026-12-31'
  holidays:
    - '2026-01-01'
    - '2026-01-02'
    - '2026-02-16'
    - '2026-02-17'
    - '2026-02-18'
    - '2026-02-19'
    - '2026-02-20'
    - '2026-02-23'
    - '2026-04-06'
    - '2026-05-01'
    - '2026-05-04'
    - '2026-05-05'
    - '2026-06-19'
    - '2026-09-25'
    - '2026-10-01'
    - '2026-10-02'
    - '2026-10-05'
    - '2026-10-06'
    - '2026-10-07'
