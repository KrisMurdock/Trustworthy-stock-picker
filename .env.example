# Stock Watcher 运行参数。复制为根目录 .env 后使用：
#   cp .env.example .env
#   make run
# Docker Compose 也读取同一份根 .env（见 docker/compose.yaml）。
# 业务配置不再读取 config.yaml 或 feishu.config；观测股池仍独立保存在 leaders.yaml。

# ---- 基础 ----
STOCK_WATCHER_DATA_DIR=data
# 默认本地存储，init 会自动创建 data/。使用 Windows/CIFS 挂载盘时设为 true，
# 并把 STOCK_WATCHER_DATA_DIR 指向实际挂载目录。
STOCK_WATCHER_REQUIRE_CIFS=false
STOCK_WATCHER_POLL_INTERVAL=5m
STOCK_WATCHER_REQUEST_TIMEOUT=10s
# 观测股池独立文件；相对路径按当前工作目录解析。大量股票不要放进 .env。
STOCK_WATCHER_POOL_FILE=leaders.yaml

# ---- 分析 / 策略 ----
STOCK_WATCHER_ANALYSIS_ENGINE=auto
STOCK_WATCHER_ANALYSIS_TIMEOUT=10m
STOCK_WATCHER_ANALYSIS_SYNC_TIMEOUT=90m
STOCK_WATCHER_STRATEGY_ENABLED=true
STOCK_WATCHER_STRATEGY_TARGET_NET_PCT=3
STOCK_WATCHER_STRATEGY_STOP_NET_PCT=-3
STOCK_WATCHER_STRATEGY_MAX_HOLDING_DAYS=5
STOCK_WATCHER_STRATEGY_TRADE_CASH=20000
STOCK_WATCHER_STRATEGY_COMMISSION_RATE=0.0001
STOCK_WATCHER_STRATEGY_MIN_COMMISSION=5
STOCK_WATCHER_STRATEGY_TRANSFER_RATE=0.00001
STOCK_WATCHER_STRATEGY_SELL_STAMP_RATE=0.0005
STOCK_WATCHER_STRATEGY_SLIPPAGE_RATE=0.0005
STOCK_WATCHER_STRATEGY_MAX_ENTRY_GAP_PCT=3
STOCK_WATCHER_STRATEGY_MIN_EVIDENCE=60
STOCK_WATCHER_STRATEGY_MIN_TRAINING_DAYS=40
STOCK_WATCHER_STRATEGY_HOLDOUT_DAYS=40
STOCK_WATCHER_STRATEGY_MIN_RANK_SCORE=60
STOCK_WATCHER_STRUCTURE_GUARD_MODE=shadow

# ---- 网页 / 日线 / 筛选 ----
STOCK_WATCHER_WEB_ENABLED=true
STOCK_WATCHER_WEB_ADDR=127.0.0.1:8080
STOCK_WATCHER_DAILY_RUN_AT=18:05
STOCK_WATCHER_DAILY_HISTORY_DAYS=365
STOCK_WATCHER_DAILY_ADJUST=qfq
STOCK_WATCHER_SELECTION_ENABLED=true
STOCK_WATCHER_SELECTION_MIN_SCORE=70
STOCK_WATCHER_SELECTION_TOP_N=5
STOCK_WATCHER_SELECTION_MIN_VOLUME_RATIO=1.2
STOCK_WATCHER_SELECTION_RSI_MIN=50
STOCK_WATCHER_SELECTION_RSI_MAX=80
STOCK_WATCHER_SELECTION_MIN_DAY_CHANGE=-3
STOCK_WATCHER_SELECTION_MAX_DAY_CHANGE=7

# ---- 同步 / 日历 ----
STOCK_WATCHER_SYNC_MIN_COVERAGE_PCT=95
STOCK_WATCHER_SYNC_MIN_ANALYZABLE_PCT=90
STOCK_WATCHER_SYNC_INCREMENTAL_BARS=5
STOCK_WATCHER_SYNC_STATUS_REFRESH_DAYS=30
STOCK_WATCHER_CALENDAR_VALID_FROM=2026-01-01
STOCK_WATCHER_CALENDAR_VALID_THROUGH=2026-12-31
STOCK_WATCHER_CALENDAR_HOLIDAYS="2026-01-01,2026-01-02,2026-02-16,2026-02-17,2026-02-18,2026-02-19,2026-02-20,2026-02-23,2026-04-06,2026-05-01,2026-05-04,2026-05-05,2026-06-19,2026-09-25,2026-10-01,2026-10-02,2026-10-05,2026-10-06,2026-10-07"

# ---- 行情源 ----
STOCK_WATCHER_MARKET_PROVIDERS=tencent,sina,baostock,tushare,eastmoney
STOCK_WATCHER_MARKET_REQUEST_INTERVAL=1s
STOCK_WATCHER_MARKET_ATTEMPT_TIMEOUT=60s
STOCK_WATCHER_MARKET_FAILURE_THRESHOLD=3
STOCK_WATCHER_MARKET_FAILURE_COOLDOWN=5m
STOCK_WATCHER_MARKET_TENCENT_ENDPOINT=https://proxy.finance.qq.com/ifzqgtimg/appstock/app/newfqkline/get
STOCK_WATCHER_MARKET_SINA_ENDPOINT=https://finance.sina.com.cn/realstock/company
STOCK_WATCHER_MARKET_BAOSTOCK_ADDRESS=public-api.baostock.com:10030
STOCK_WATCHER_MARKET_TUSHARE_ENDPOINT=https://api.tushare.pro
STOCK_WATCHER_MARKET_TUSHARE_TOKEN_ENV=TUSHARE_TOKEN
STOCK_WATCHER_MARKET_EASTMONEY_ENDPOINT=https://push2his.eastmoney.com/api/qt/stock/kline/get
STOCK_WATCHER_MARKET_LISTING_ENDPOINT=https://vip.stock.finance.sina.com.cn/corp/go.php/vISSUE_NewStock/stockid
# Optional. Never commit a real token.
# TUSHARE_TOKEN=REPLACE_ME

# ---- 分钟行情 ----
STOCK_WATCHER_INTRADAY_ENABLED=true
STOCK_WATCHER_INTRADAY_POLL_INTERVAL=1m
STOCK_WATCHER_INTRADAY_REQUEST_INTERVAL=350ms
STOCK_WATCHER_INTRADAY_WORKERS=3
STOCK_WATCHER_INTRADAY_CALIBRATION_AT=15:10
STOCK_WATCHER_INTRADAY_TENCENT_ENDPOINT=https://proxy.finance.qq.com/ifzqgtimg/appstock/app/kline/mkline

# ---- 通知 ----
# 首次启动默认关闭通知。启用时设置 enabled=true 并提供 webhook。
STOCK_WATCHER_FEISHU_ENABLED=false
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_ME
# FEISHU_SECRET=REPLACE_ME
# 可选命名通道；使用后不要再启用 legacy Feishu。格式：
# name|type|enabled|webhook_env|secret_env
# STOCK_WATCHER_NOTIFY_CHANNELS="feishu-main|feishu|true|FEISHU_WEBHOOK|FEISHU_SECRET"

# ---- 日志 ----
STOCK_WATCHER_LOG_DIR=logs
STOCK_WATCHER_LOG_MAX_MB=10
STOCK_WATCHER_LOG_MAX_DAYS=7
STOCK_WATCHER_LOG_BACKUPS=10
STOCK_WATCHER_LOG_JSON=false
STOCK_WATCHER_LOG_COLOR=auto

# ---- Docker Compose（仅容器启动使用）----
STOCK_WATCHER_IMAGE=stock-watcher:local
STOCK_WATCHER_VERSION=development
STOCK_WATCHER_WEB_BIND=127.0.0.1:8080
# 以下相对路径以 docker/compose.yaml 所在目录为基准；生产也可改为绝对路径。
# CIFS 部署时改为实际挂载路径，并设置 STOCK_WATCHER_REQUIRE_CIFS=true。
STOCK_WATCHER_HOST_DATA=../data
STOCK_WATCHER_HOST_POOL=../leaders.yaml
STOCK_WATCHER_HOST_LOGS=../logs
# Compose 默认读取 ../.env（相对 docker/compose.yaml）；通常无需设置。
# STOCK_WATCHER_ENV_FILE=/absolute/path/to/.env

# ---- 旧凭证文件兼容项（默认不启用）----
# STOCK_WATCHER_FEISHU_CREDENTIALS_FILE=feishu.config
