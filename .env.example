# Stock Watcher 运行参数。复制为根目录 .env 后使用：
#   cp .env.example .env
#   make run
# Docker Compose 也读取同一份根 .env（见 docker/compose.yaml）。
# 业务配置不再读取 config.yaml 或 feishu.config；观测股池仍独立保存在 leaders.yaml。

# ---- 基础 ----
STOCK_WATCHER_DATA_DIR=data
# 默认本地存储，init 会自动创建 data/。使用 Windows/CIFS 挂载盘时设为 true，
# 并把 STOCK_WATCHER_DATA_DIR 指向实际挂载目录。
STOCK_WATCHER_REQUIRE_CIFS=false
STOCK_WATCHER_POLL_INTERVAL=5m
STOCK_WATCHER_REQUEST_TIMEOUT=10s
# 观测股池独立文件；相对路径按当前工作目录解析。大量股票不要放进 .env。
STOCK_WATCHER_POOL_FILE=leaders.yaml

# ---- 分析 / 策略 ----
STOCK_WATCHER_ANALYSIS_ENGINE=auto
STOCK_WATCHER_ANALYSIS_TIMEOUT=10m
STOCK_WATCHER_ANALYSIS_SYNC_TIMEOUT=90m
STOCK_WATCHER_STRATEGY_ENABLED=true
STOCK_WATCHER_STRATEGY_TARGET_NET_PCT=3
STOCK_WATCHER_STRATEGY_STOP_NET_PCT=-3
STOCK_WATCHER_STRATEGY_MAX_HOLDING_DAYS=5
STOCK_WATCHER_STRATEGY_TRADE_CASH=20000
STOCK_WATCHER_STRATEGY_COMMISSION_RATE=0.0001
STOCK_WATCHER_STRATEGY_MIN_COMMISSION=5
STOCK_WATCHER_STRATEGY_TRANSFER_RATE=0.00001
STOCK_WATCHER_STRATEGY_SELL_STAMP_RATE=0.0005
STOCK_WATCHER_STRATEGY_SLIPPAGE_RATE=0.0005
STOCK_WATCHER_STRATEGY_MAX_ENTRY_GAP_PCT=3
STOCK_WATCHER_STRATEGY_MIN_EVIDENCE=60
STOCK_WATCHER_STRATEGY_MIN_TRAINING_DAYS=40
STOCK_WATCHER_STRATEGY_HOLDOUT_DAYS=40
STOCK_WATCHER_STRATEGY_MIN_RANK_SCORE=60
STOCK_WATCHER_STRUCTURE_GUARD_MODE=shadow

# ---- 网页 / 日线 / 筛选 ----
STOCK_WATCHER_WEB_ENABLED=true
STOCK_WATCHER_WEB_ADDR=127.0.0.1:8080
# 公网匿名访问时设为 true：只允许 GET/HEAD，并隐藏 AI 与预测写入口。
STOCK_WATCHER_WEB_PUBLIC_READ_ONLY=false
# 临时 Cloudflare 公网隧道默认关闭；仅 make run 启动器读取此开关。
STOCK_WATCHER_PUBLIC_TUNNEL_ENABLED=false
STOCK_WATCHER_DAILY_RUN_AT=15:00
STOCK_WATCHER_DAILY_HISTORY_DAYS=365
STOCK_WATCHER_DAILY_ADJUST=qfq
STOCK_WATCHER_SELECTION_ENABLED=true
STOCK_WATCHER_SELECTION_MIN_SCORE=70
STOCK_WATCHER_SELECTION_TOP_N=5
STOCK_WATCHER_SELECTION_MIN_VOLUME_RATIO=1.2
STOCK_WATCHER_SELECTION_RSI_MIN=50
STOCK_WATCHER_SELECTION_RSI_MAX=80
STOCK_WATCHER_SELECTION_MIN_DAY_CHANGE=-3
STOCK_WATCHER_SELECTION_MAX_DAY_CHANGE=7
# 第一层高召回初筛：只生成第二层候选池，不改变正式推荐。
STOCK_WATCHER_FIRST_STAGE_ENABLED=true
STOCK_WATCHER_FIRST_STAGE_PUSH_ENABLED=true
STOCK_WATCHER_FIRST_STAGE_BUDGET=95
# 第二层精排：读取 JEV/Laya/Chinese Decision 离线 artifact，按生产 blend 输出 Top10。
STOCK_WATCHER_SECOND_STAGE_ENABLED=true
STOCK_WATCHER_SECOND_STAGE_PUSH_ENABLED=true
STOCK_WATCHER_SECOND_STAGE_TOP_N=10
STOCK_WATCHER_SECOND_STAGE_PUBLISH_BY=15:28
STOCK_WATCHER_SECOND_STAGE_BLEND_ID=risk_all20_local035_eta1
STOCK_WATCHER_SECOND_STAGE_FIRST_STAGE_WEIGHT=0.2
STOCK_WATCHER_SECOND_STAGE_MODELS=jev=0.2,laya_official=0.2,laya_multilingual=0.2,chinese_decision=0.2
STOCK_WATCHER_SECOND_STAGE_GROUP_SIZE=5
STOCK_WATCHER_SECOND_STAGE_CALIBRATION=local
STOCK_WATCHER_SECOND_STAGE_CALIBRATION_PARAM=0.35
STOCK_WATCHER_SECOND_STAGE_RISK_ETA=1
# 三模型示例（第一层 40% + 三个模型各 20%，合计必须为 1）：
# STOCK_WATCHER_SECOND_STAGE_FIRST_STAGE_WEIGHT=0.4
# STOCK_WATCHER_SECOND_STAGE_MODELS=jev=0.2,laya_official=0.2,laya_multilingual=0.2
# Chinese Decision 示例：STOCK_WATCHER_SECOND_STAGE_MODELS=jev=0.25,chinese_decision=0.25

# ---- 同步 / 日历 ----
STOCK_WATCHER_SYNC_MIN_COVERAGE_PCT=95
STOCK_WATCHER_SYNC_MIN_ANALYZABLE_PCT=90
STOCK_WATCHER_SYNC_INCREMENTAL_BARS=5
STOCK_WATCHER_SYNC_STATUS_REFRESH_DAYS=30
STOCK_WATCHER_CALENDAR_VALID_FROM=2026-01-01
STOCK_WATCHER_CALENDAR_VALID_THROUGH=2026-12-31
STOCK_WATCHER_CALENDAR_HOLIDAYS="2026-01-01,2026-01-02,2026-02-16,2026-02-17,2026-02-18,2026-02-19,2026-02-20,2026-02-23,2026-04-06,2026-05-01,2026-05-04,2026-05-05,2026-06-19,2026-09-25,2026-10-01,2026-10-02,2026-10-05,2026-10-06,2026-10-07"

# ---- 行情源 ----
STOCK_WATCHER_MARKET_PROVIDERS=tencent,sina,baostock,tushare,eastmoney
STOCK_WATCHER_MARKET_REQUEST_INTERVAL=1s
STOCK_WATCHER_MARKET_ATTEMPT_TIMEOUT=60s
STOCK_WATCHER_MARKET_FAILURE_THRESHOLD=3
STOCK_WATCHER_MARKET_FAILURE_COOLDOWN=5m
STOCK_WATCHER_MARKET_TENCENT_ENDPOINT=https://proxy.finance.qq.com/ifzqgtimg/appstock/app/newfqkline/get
STOCK_WATCHER_MARKET_SINA_ENDPOINT=https://finance.sina.com.cn/realstock/company
STOCK_WATCHER_MARKET_BAOSTOCK_ADDRESS=public-api.baostock.com:10030
STOCK_WATCHER_MARKET_TUSHARE_ENDPOINT=https://api.tushare.pro
STOCK_WATCHER_MARKET_TUSHARE_TOKEN_ENV=TUSHARE_TOKEN
STOCK_WATCHER_MARKET_EASTMONEY_ENDPOINT=https://push2his.eastmoney.com/api/qt/stock/kline/get
STOCK_WATCHER_MARKET_LISTING_ENDPOINT=https://vip.stock.finance.sina.com.cn/corp/go.php/vISSUE_NewStock/stockid
# Optional. Never commit a real token.
# TUSHARE_TOKEN=REPLACE_ME

# ---- 指数与板块（默认随 sync/run 同步）----
STOCK_WATCHER_CONTEXT_ENABLED=true
STOCK_WATCHER_CONTEXT_REQUEST_INTERVAL=350ms
STOCK_WATCHER_CONTEXT_WORKERS=3
STOCK_WATCHER_CONTEXT_HISTORY_LIMIT=10000
STOCK_WATCHER_CONTEXT_EASTMONEY_LIST_ENDPOINT=https://push2.eastmoney.com/api/qt/clist/get
STOCK_WATCHER_CONTEXT_EASTMONEY_KLINE_ENDPOINT=http://push2his.eastmoney.com/api/qt/stock/kline/get
STOCK_WATCHER_CONTEXT_TENCENT_ENDPOINT=https://proxy.finance.qq.com/ifzqgtimg/appstock/app/newfqkline/get
STOCK_WATCHER_CONTEXT_KOREA_ENDPOINT=https://api.finance.naver.com/siseJson.naver
STOCK_WATCHER_CONTEXT_HANG_SENG_ENDPOINT=https://web.ifzq.gtimg.cn/appstock/app/fqkline/get
STOCK_WATCHER_CONTEXT_KOREA_MINUTE_ENDPOINT=https://api.stock.naver.com/chart/domestic/index

# ---- 分钟行情 ----
STOCK_WATCHER_INTRADAY_ENABLED=true
STOCK_WATCHER_INTRADAY_POLL_INTERVAL=1m
STOCK_WATCHER_INTRADAY_REQUEST_INTERVAL=350ms
STOCK_WATCHER_INTRADAY_WORKERS=3
STOCK_WATCHER_INTRADAY_CALIBRATION_AT=15:10
STOCK_WATCHER_INTRADAY_TENCENT_ENDPOINT=https://proxy.finance.qq.com/ifzqgtimg/appstock/app/kline/mkline

# 5 分钟实验性预测（只推送观察结果，不连接券商）
STOCK_WATCHER_PREDICTOR_ENABLED=true
STOCK_WATCHER_PREDICTOR_PUSH_ENABLED=true
STOCK_WATCHER_PREDICTOR_TRAIN_AT=15:30
STOCK_WATCHER_PREDICTOR_WRITE_MODE=loopback
STOCK_WATCHER_PREDICTOR_MIN_TRAINING_DAYS=5
STOCK_WATCHER_PREDICTOR_VALIDATION_DAYS=3
STOCK_WATCHER_PREDICTOR_KEEP_MODELS=10

# 全天高低价预测（默认关闭；写入 dayrange.db，启用推送时发往 predictor_dayrange 机器人）
STOCK_WATCHER_DAYRANGE_ENABLED=false
STOCK_WATCHER_DAYRANGE_PUSH_ENABLED=true
STOCK_WATCHER_DAYRANGE_TRAIN_AT=15:40
STOCK_WATCHER_DAYRANGE_PREDICT_AT=08:45
STOCK_WATCHER_DAYRANGE_RECONCILE_AT=18:35
STOCK_WATCHER_DAYRANGE_HISTORY_DAYS=365
STOCK_WATCHER_DAYRANGE_MIN_TRAIN_DAYS=120
STOCK_WATCHER_DAYRANGE_CALIBRATION_DAYS=60
STOCK_WATCHER_DAYRANGE_VALIDATION_DAYS=20
STOCK_WATCHER_DAYRANGE_KEEP_MODELS=10
STOCK_WATCHER_DAYRANGE_STOCK_FEATURES=true
STOCK_WATCHER_DAYRANGE_MARKET_FEATURES=true
STOCK_WATCHER_DAYRANGE_SECTOR_FEATURES=true

# ---- AI 复盘与问问大师 ----
# 环境变量提供即锁定对应字段；网页只能修改未锁定字段。
STOCK_WATCHER_LLM_ENABLED=true
STOCK_WATCHER_LLM_BASE_URL=https://api.openai.com/v1
# STOCK_WATCHER_LLM_API_KEY=REPLACE_ME
STOCK_WATCHER_LLM_MODEL=gpt-4.1-mini
STOCK_WATCHER_LLM_TIMEOUT=60s
# 网页保存的私有配置，保持 0600；不要放在 CIFS 数据目录内。
STOCK_WATCHER_LLM_CONFIG_FILE=llm.config
# 网页写配置范围：off | loopback | all；远程部署还需认证反向代理。
STOCK_WATCHER_LLM_WRITE_MODE=loopback

# ---- 通知 ----
# 首次启动默认关闭通知。启用时设置 enabled=true 并提供 webhook。
STOCK_WATCHER_FEISHU_ENABLED=false
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_ME
# FEISHU_SECRET=REPLACE_ME

# ---- 微信公众号草稿（只创建草稿，不发布、不群发） ----
# 未认证公众号可以调用 draft/add；正式发布和群发仍需认证后在公众号后台操作。
# AppSecret 可从环境变量或私有 wechat.config 读取，不能提交或粘贴到聊天。
# 需要把运行主机的公网出口 IP 加入公众号后台的 IP 白名单。
STOCK_WATCHER_WECHAT_ENABLED=false
# 可选：读取权限为 600 的私有凭证文件；环境变量优先于文件。
# STOCK_WATCHER_WECHAT_CREDENTIALS_FILE=wechat.config
# WECHAT_APP_ID=REPLACE_ME
# WECHAT_APP_SECRET=REPLACE_ME
# 可选：公众号永久图片素材 media_id；留空时首次发送会自动上传内置封面。
# WECHAT_THUMB_MEDIA_ID=REPLACE_ME
# 可选：作者名，最多 16 个字符。
# STOCK_WATCHER_WECHAT_AUTHOR=Stock Watcher
# 仅第二层精排文章会进入草稿箱，且需要 second_stage.enabled 与 push_enabled 同时为 true。
# 渠道名固定为 wechat-draft；本通道没有发布或群发开关。

# 可选命名通道；使用后不要再启用 legacy Feishu。格式：
# name|type|enabled|webhook_env|secret_env|route
# route 可选 all、selection、first_stage、second_stage、premarket_execution、predictor_realtime、predictor_dayrange；
# 留空兼容旧配置，表示向所有阶段广播。
# STOCK_WATCHER_NOTIFY_CHANNELS="first-stage|feishu|true|FEISHU_FIRST_STAGE_WEBHOOK||first_stage;second-stage|feishu|true|FEISHU_SECOND_STAGE_WEBHOOK||second_stage;selection|feishu|true|FEISHU_SELECTION_WEBHOOK||selection;premarket-execution|feishu|true|FEISHU_PREMARKET_EXECUTION_WEBHOOK||premarket_execution;predictor-realtime|feishu|true|FEISHU_PREDICTOR_REALTIME_WEBHOOK||predictor_realtime;predictor-dayrange|feishu|true|FEISHU_PREDICTOR_DAYRANGE_WEBHOOK||predictor_dayrange"

# ---- 日志 ----
STOCK_WATCHER_LOG_DIR=logs
STOCK_WATCHER_LOG_MAX_MB=10
STOCK_WATCHER_LOG_MAX_DAYS=7
STOCK_WATCHER_LOG_BACKUPS=10
STOCK_WATCHER_LOG_JSON=false
STOCK_WATCHER_LOG_COLOR=auto

# ---- Docker Compose（仅容器启动使用）----
STOCK_WATCHER_IMAGE=stock-watcher:local
STOCK_WATCHER_VERSION=development
STOCK_WATCHER_WEB_BIND=127.0.0.1:8080
# 以下相对路径以 docker/compose.yaml 所在目录为基准；生产也可改为绝对路径。
# CIFS 部署时改为实际挂载路径，并设置 STOCK_WATCHER_REQUIRE_CIFS=true。
STOCK_WATCHER_HOST_DATA=../data
STOCK_WATCHER_HOST_POOL=../leaders.yaml
STOCK_WATCHER_HOST_LOGS=../logs
# Compose 默认读取 ../.env（相对 docker/compose.yaml）；通常无需设置。
# STOCK_WATCHER_ENV_FILE=/absolute/path/to/.env

# ---- 旧凭证文件兼容项（默认不启用）----
# STOCK_WATCHER_FEISHU_CREDENTIALS_FILE=feishu.config
