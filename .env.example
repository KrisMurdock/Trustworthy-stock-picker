# 可复制为根目录 .env（make run 会加载）；私有配置不要提交。
# 默认本地存储：不设置数据目录时使用 ./data，init 会自动创建。
# 使用已挂载的 Windows/CIFS 共享盘时，同时设置目录和 REQUIRE_CIFS。
# STOCK_WATCHER_DATA_DIR=/mnt/windows_database
# STOCK_WATCHER_REQUIRE_CIFS=true
# 网页默认仅本机访问；随 make run 启动。
# STOCK_WATCHER_WEB_ADDR=127.0.0.1:8080
# 仅启用飞书通知时需要凭证；空变量也会覆盖 feishu.config。
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_ME
# FEISHU_SECRET=REPLACE_ME
# Optional: enables Tushare in the ordered market fallback chain. Never commit a real token.
# The account needs both daily and adj_factor access when daily.adjust=qfq/hfq.
# TUSHARE_TOKEN=REPLACE_ME
STOCK_WATCHER_LOG_DIR=logs
STOCK_WATCHER_LOG_MAX_MB=10
STOCK_WATCHER_LOG_MAX_DAYS=7
STOCK_WATCHER_LOG_BACKUPS=10
STOCK_WATCHER_LOG_JSON=false
STOCK_WATCHER_LOG_COLOR=auto
