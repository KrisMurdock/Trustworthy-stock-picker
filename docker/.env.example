# Compose 插值参数；从仓库根目录用 --env-file docker/.env 调用。
STOCK_WATCHER_IMAGE=stock-watcher:local
STOCK_WATCHER_VERSION=development
# Host bind address for the read-only dashboard.
STOCK_WATCHER_WEB_BIND=127.0.0.1:8080
# 使用绝对路径；必须事先存在，Compose 不会自动创建。
# 本地存储可改为 /root/data/codebase/toys_project/stock_watcher/data；共享盘指向已挂载目录。
STOCK_WATCHER_HOST_DATA=/mnt/windows_database
STOCK_WATCHER_HOST_POOL=/root/data/codebase/toys_project/stock_watcher/leaders.yaml
STOCK_WATCHER_HOST_LOGS=/root/data/codebase/toys_project/stock_watcher/logs
# 独立运行时环境文件：不要在此文件填写 webhook。
STOCK_WATCHER_RUNTIME_ENV=/etc/stock-watcher.env
